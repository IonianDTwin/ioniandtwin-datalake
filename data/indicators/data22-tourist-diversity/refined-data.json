    "refined_data.data22_tourist_diversity.<year>.nights": {
      "type": "object",
      "unit": "nights",
      "role": "input_variable",
      "description": "Total annual overnight stays per NUTS3 island unit."
    },
    "refined_data.data22_tourist_diversity.<year>.shares": {
      "type": "object",
      "unit": "ratio (0-1)",
      "role": "input_variable",
      "description": "Fraction of EL62 regional nights hosted by each NUTS3 unit."
    },
    "refined_data.data22_tourist_diversity.<year>.HHI": {
      "type": "number",
      "unit": "index (0-1)",
      "role": "input_variable",
      "description": "Herfindahl-Hirschman concentration index sum(s_i^2)."
    },
    "refined_data.data22_tourist_diversity.<year>.diversity_1_minus_HHI": {
      "type": "number",
      "unit": "index (0-1)",
      "role": "target_indicator",
      "description": "Regional spatial diversity index 1 - HHI emitted for NUTS2/EL62 (0.631 to 0.651)."
    }
  },
