{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ionian-dtwin.local/schemas/observation-schema.json",
  "title": "IonianDTwin Observation",
  "description": "A single normalised observation value with provenance and spatial/temporal reference.",
  "type": "object",
  "required": [
    "observation_id",
    "indicator_id",
    "source_id",
    "observed_at",
    "ingested_at",
    "spatial_ref",
    "value",
    "unit"
  ],
  "properties": {
    "observation_id": { "type": "string", "description": "Stable unique id" },
    "indicator_id": { "type": "string", "description": "References indicators/indicator-metadata.yaml" },
    "source_id": { "type": "string", "description": "References sources/source-registry.md" },
    "observed_at": { "type": "string", "description": "ISO 8601 with explicit timezone (value time)" },
    "ingested_at": { "type": "string", "description": "ISO 8601 with explicit timezone (ingestion time)" },
    "spatial_ref": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["NUTS2", "municipality", "tourism_zone", "beach", "transport_node", "poi", "point"] },
        "code": { "type": ["string", "null"] },
        "geometry": {
          "type": ["object", "null"],
          "description": "GeoJSON geometry; null when not point-referenced"
        }
      },
      "required": ["level"]
    },
    "value": { "type": ["number", "string", "boolean"], "description": "Typed raw value; string for categorical" },
    "unit": { "type": ["string", "null"] },
    "polarity": { "type": ["string", "null"], "enum": ["positive", "negative", null] },
    "quality": {
      "type": "object",
      "properties": {
        "coverage": { "type": "number" },
        "completeness": { "type": "number" },
        "plausibility": { "type": "string" },
        "cross_verified": { "type": "boolean", "description": "true when citizen report confirmed by sensor" }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "raw_checksum_sha256": { "type": ["string", "null"] },
        "raw_manifest": { "type": ["string", "null"] },
        "access_method": { "type": ["string", "null"] },
        "request_params": { "type": "object" }
      }
    }
  },
  "additionalProperties": true
}
