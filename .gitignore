# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/
.env
*.env.local

# Data — keep raw/sensitive data out of Git; curated observations are small,
# public, non-sensitive aggregates and are intentionally tracked for publication.
data/raw/*
data/staging/*
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/samples/.gitkeep
!data/manifests/.gitkeep

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs and caches
*.log
.cache/

# Windows alternate-data-stream metadata (from WSL/Windows copies)
*Zone.Identifier
